<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DarkEyes.Backend\DarkEyes.Backend.csproj" />
  </ItemGroup>

  <Target Name="CopyToUnityPlugins" AfterTargets="Build">
    <PropertyGroup>
      <UnityPluginsDir>$(MSBuildProjectDirectory)\..\DarkEyes.Unity\Assets\Plugins\</UnityPluginsDir>
    </PropertyGroup>

    <MakeDir Directories="$(UnityPluginsDir)" />

    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(UnityPluginsDir)" SkipUnchangedFiles="true" OverwriteReadOnlyFiles="true" />

    <Message Importance="high" Text="Copied rule module DLL to $(UnityPluginsDir)" />
  </Target>

</Project>
